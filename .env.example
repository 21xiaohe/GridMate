# 复制为 .env 后填写；仅本地保存密钥。
# 聊天模型需支持工具调用和结构化输出，模型名以账号实际可用值为准。
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=replace-with-your-model
CHAT_API_KEY=replace-with-your-key

# 仅在服务商明确支持时填写以下扩展；留空使用上游默认。
CHAT_THINKING=
CHAT_REASONING_EFFORT=
CHAT_REASONING_SPLIT=

# 向量维度当前固定为 1024；替换模型时需同步核对维度并重新发布。
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=replace-with-your-key

# 使用 /rerank 接口；不等同于聊天接口。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=replace-with-your-key
MILVUS_URI=http://localhost:19530
